{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "HTTP Request Throughput (Req / min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(cricket_http_requests_total[1m])) * 60",
          "legendFormat": "Requests / min"
        }
      ]
    },
    {
      "title": "95th Percentile Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(cricket_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency (s)"
        }
      ]
    },
    {
      "title": "HTTP Error Rate (5xx)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(cricket_http_requests_total{status_code=~\"5..\"}[5m])) or vector(0)",
          "legendFormat": "5xx Errors"
        }
      ]
    },
    {
      "title": "Match Live Scoring Operations",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(cricket_match_score_updates_total[1m])) by (update_type)",
          "legendFormat": "{{update_type}}"
        }
      ]
    },
    {
      "title": "ML Prediction Inference Latency",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"cricket-ml-service\"}[1m]))",
          "legendFormat": "ML Inferences / sec"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["cricket", "devops", "mlops"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "Smart Cricket Tracker - Observability Dashboard"
}
